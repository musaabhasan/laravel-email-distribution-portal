APP_NAME="Email Distribution Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=email_distribution_portal
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.org
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_BATCH_LIMIT=400
BROADCAST_WINDOW_MINUTES=60
BROADCAST_RETRY_MINUTES=15
BROADCAST_MAX_ATTEMPTS=3
BROADCAST_REQUIRE_APPROVAL=true
BROADCAST_ALLOWED_FROM_DOMAINS=example.org

SECURITY_REQUIRE_MFA=true
SECURITY_AUDIT_RETENTION_DAYS=365
DELIVERABILITY_MIN_DNS_SCORE=80
